<Window x:Class="HardwareMonitor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="硬件监控" Width="1220" Height="820" MinWidth="900" MinHeight="600" Background="#0D1117" Closing="Window_Closing">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Foreground" Value="#D7E0EA"/><Setter Property="Background" Value="#18232F"/><Setter Property="BorderBrush" Value="#2B3A4A"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
<Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#748297"/><Setter Property="FontSize" Value="13"/></Style>
<Style x:Key="Value" TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F5F8"/><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
</Window.Resources>
<Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel DockPanel.Dock="Left"><TextBlock Text="硬件监控" Foreground="#F2F5F8" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="实时性能 · 温度 · 传感器" Foreground="#748297" Margin="0,5,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="监控中" Foreground="#55D6BE" VerticalAlignment="Center"/><Button Content="立即刷新" Click="Refresh_Click"/><Button Content="设置" Click="Settings_Click"/><Button Content="退出" Click="Exit_Click"/></StackPanel></DockPanel>
<Border Grid.Row="1" Background="#151D27" BorderBrush="#253242" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18"><DockPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><TextBlock Text="状态" Foreground="#748297"/><TextBlock Text="{Binding Status}" Foreground="#D7E0EA" Margin="16,0,0,0"/></StackPanel><TextBlock Text="{Binding LastUpdated}" DockPanel.Dock="Right" Foreground="#748297"/></DockPanel></Border>
<TextBlock Grid.Row="2" Text="核心摘要" Foreground="#F2F5F8" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
<ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="355" Height="245" Margin="0,0,16,16" Padding="20" Background="#151D27" BorderBrush="#253242" BorderThickness="1" CornerRadius="16"><StackPanel><DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Left"><TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontSize="18"/><TextBlock Text="{Binding HardwareName}" Foreground="#F2F5F8" FontSize="18" FontWeight="SemiBold" MaxWidth="250" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding HardwareType}" Foreground="{Binding Accent}" FontSize="12"/></StackPanel><Button Content="详情" Tag="{Binding HardwareName}" Click="Detail_Click" DockPanel.Dock="Right"/></DockPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="温度"/><TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Temperature}"/><TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="使用率" Margin="0,10,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Load}" Margin="0,10,0,0"/><ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Height="5" Margin="0,8,0,0" Value="{Binding LoadValue, Mode=OneWay}" Maximum="100" Background="#253242" Foreground="{Binding Accent}"/><TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="吞吐 / 频率" Margin="0,10,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Throughput}" Margin="0,10,0,0"/><TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="风扇" Margin="0,10,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Fan}" Margin="0,10,0,0"/><TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="功耗" Margin="0,10,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Power}" Margin="0,10,0,0"/></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<TextBlock Grid.Row="4" Text="提示：点击详情可筛选、搜索、复制或导出传感器数据。" Foreground="#59677A" FontSize="12" Margin="2,14,0,0"/></Grid></Window>

