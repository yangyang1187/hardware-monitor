<Window x:Class="HardwareMonitor.App.Views.HardwareDetailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="传感器详情" Width="820" Height="560" Background="#F4F6F8">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock Text="{Binding HardwareName}" FontSize="24" FontWeight="SemiBold" Foreground="#17212B" Margin="0,0,0,14"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><ComboBox x:Name="FilterBox" Width="120" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem>全部</ComboBoxItem><ComboBoxItem>温度</ComboBoxItem><ComboBoxItem>负载</ComboBoxItem><ComboBoxItem>频率</ComboBoxItem><ComboBoxItem>功耗</ComboBoxItem><ComboBoxItem>风扇</ComboBoxItem><ComboBoxItem>电压</ComboBoxItem></ComboBox><TextBox x:Name="SearchBox" Width="220" Margin="10,0,0,0" TextChanged="FilterChanged"/><Button Content="复制读数" Margin="10,0,0,0" Click="Copy_Click"/><Button Content="导出 CSV" Click="Export_Click"/></StackPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding Readings}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="硬件" Binding="{Binding HardwareName}" Width="2*"/><DataGridTextColumn Header="传感器" Binding="{Binding SensorName}" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding KindName}" Width="*"/><DataGridTextColumn Header="读数" Binding="{Binding DisplayValue}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid>
</Grid></Window>
