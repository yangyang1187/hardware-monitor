<Window x:Class="HardwareMonitor.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置" Width="520" Height="430" WindowStartupLocation="CenterOwner"><StackPanel Margin="24"><TextBlock Text="监控设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="刷新间隔（秒）"/><ComboBox x:Name="IntervalBox" Margin="0,4,0,12"><ComboBoxItem>0.5</ComboBoxItem><ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem><ComboBoxItem>5</ComboBoxItem></ComboBox><CheckBox x:Name="TrayBox" Content="关闭窗口时最小化到托盘" Margin="0,0,0,10"/><CheckBox x:Name="CoreTempBox" Content="启用 Core Temp Shared Memory" IsChecked="True" Margin="0,0,0,10"/><TextBlock Text="主题"/><ComboBox x:Name="ThemeBox" Margin="0,4,0,20"><ComboBoxItem>跟随系统</ComboBoxItem><ComboBoxItem>浅色</ComboBoxItem><ComboBoxItem>深色</ComboBoxItem></ComboBox><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="Cancel_Click"/><Button Content="保存" Click="Save_Click"/></StackPanel></StackPanel></Window>
